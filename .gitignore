# Ambiente Python
.venv/
__pycache__/
*.pyc

# Configuracao local
.env

# Dados (PDFs e texto processado podem ser grandes/variaveis)
data/raw/*
data/processed/*
data/legislacao/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/legislacao/.gitkeep

# Modelos baixados pelo sentence-transformers (cache)
.cache/

# Node.js
node_modules/

# Docx descompactados (artefatos de inspeção, redundantes com os binários)
DOCUMENTO-ENVIO/unpacked_*/

# Pacotes gerados para publicacao (scripts/snapshot_corpus.py)
dist/
