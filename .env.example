# ===== Banco de dados (PostgreSQL + pgvector) =====
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tcc_rag
DB_USER=postgres
DB_PASSWORD=postgres

# ===== Embeddings (modelo local open-source) =====
# Opcoes recomendadas para portugues:
#   intfloat/multilingual-e5-small   -> 384  dimensoes (usado no TCC)
#   intfloat/multilingual-e5-large   -> 1024 dimensoes (melhor qualidade)
#   intfloat/multilingual-e5-base    -> 768  dimensoes (mais leve/rapido)
#   neuralmind/bert-base-portuguese-cased (BERTimbau) -> 768 dimensoes
# Modelo usado nos experimentos do TCC:
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# ===== Chunking =====
CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=60

# ===== LLM (Groq, API compativel com OpenAI) =====
# Chave gratuita em https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=2000
GROQ_REASONING_EFFORT=medium

# ===== Hugging Face (cache de modelos) =====
# Suprime aviso de symlinks no Windows (o cache funciona sem eles, so ocupa mais espaco)
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ===== Scraper =====
# URLs-semente do portal da UNESP de onde comecar a buscar PDFs (separadas por virgula)
SCRAPER_SEEDS=https://www.fc.unesp.br/
# Profundidade maxima de navegacao a partir das sementes
SCRAPER_MAX_DEPTH=2
# Restringir aos dominios das sementes (true/false)
SCRAPER_SAME_DOMAIN=true
